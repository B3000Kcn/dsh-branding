{
  "name": "dsh-branding",
  "version": "0.1.2",
  "description": "Favicon, day/night banner zoom and position, and custom app name across DSH Web tab titles",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/images.js",
    "src/options.js",
    "src/host/title-shell.js",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "COMPATIBILITY.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "=0.2.1-rc.2 || =0.2.2-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5 || 4.0.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5 || 3.18.6-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "license": "MIT"
}
